{
  "expo": {
    "name": "CoolWallet",
    "slug": "controlgastos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "controlgastos",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "cl.coolthings.coolwallet",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "cl.coolthings.coolwallet",
      "adaptiveIcon": {
        "backgroundColor": "#1F6F50",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1F6F50",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0F1A15",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-font",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usamos Face ID para desbloquear CoolWallet y proteger tus datos financieros."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Usamos tus fotos solo para elegir tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#1F6F50"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F5F8F6"
  }
}
